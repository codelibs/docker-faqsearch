# Copy to .env and override as needed: cp .env.example .env
# bin/setup.sh creates .env from this file on first run if none exists.
# compose.yaml and bin/render-fess-config.sh also fall back to the same
# defaults when no .env is present, so .env is optional.

# --- Image versions ---
# FESS_VERSION additionally pins the upstream fess_config.properties base that
# bin/render-fess-config.sh fetches (cached as
# data/fess/opt/fess/.fess_config.base-<version>.properties). Re-run
# bin/setup.sh after changing it; a major bump may need a re-crawl.
FESS_VERSION=15.9.0
# Must carry k-NN, ML Commons and Neural Search (the `hybrid` query);
# ghcr.io/codelibs/fess-opensearch does.
OPENSEARCH_VERSION=3.8.0
NGINX_IMAGE=nginx:alpine
OPENSEARCH_HEAP=2g

# --- Hybrid search: embedding model (OpenSearch ML Commons) ---
# Registered and deployed by the init-semantic service. The model is
# multilingual, so Japanese and English FAQs share one vector space.
MODEL_NAME=huggingface/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODEL_VERSION=1.0.1
MODEL_FORMAT=TORCH_SCRIPT
# Must match the model. Baked into the index mapping when the index is first
# created; changing it later needs a reindex.
MODEL_DIMENSION=384
# Seconds to wait for model register + deploy (the first run downloads ~490 MB).
MODEL_MAX_WAIT=900

# --- Hybrid search: chunking and vector search ---
# Characters per chunk. Keep it at least as long as the longest FAQ answer
# (and >= query.highlight.fragment.size): once a document is chunked, Fess
# stores the chunks back into `content` as an array, and the helpdesk inline
# answer (one highlighted fragment) then shows only the chunk that matched --
# a keyword in the last sentence would cut the answer's first half away.
# One chunk per FAQ also matches how FAQs are asked: by their question, which
# comes first. The model reads only the first 128 tokens (~250 Japanese
# characters) of a chunk; the keyword half of the hybrid query still matches
# the rest. Measured on the demo FAQs: 16 of 17 paraphrase checks rank the
# same top FAQ as with 250-character chunks.
CHUNK_SIZE=1000
KNN_K=100
# Minimum cosine similarity (0-1) for a FAQ to be returned by the semantic
# half of the hybrid query. Without a floor every FAQ is "similar" to every
# query in a corpus this small, so an unrelated question would list them all.
# Measured on the demo FAQs with the default model: correct paraphrases score
# 0.27-0.77 (e.g. "how much does it cost" -> pricing 0.39), unrelated
# questions ("weather forecast tomorrow") at most 0.20. Re-measure when you
# change MODEL_NAME: scores are model-specific.
SEMANTIC_MIN_SCORE=0.3
