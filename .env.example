# Copy to .env and override as needed: cp .env.example .env
# bin/setup.sh creates .env from this file on first run if none exists.
# compose.yaml and bin/render-fess-config.sh also fall back to the same
# defaults when no .env is present, so .env is optional.

# --- Image versions ---
# FESS_VERSION additionally pins the upstream fess_config.properties base that
# bin/render-fess-config.sh fetches (cached as
# data/fess/opt/fess/.fess_config.base-<version>.properties). Re-run
# bin/setup.sh after changing it; a major bump may need a re-crawl.
FESS_VERSION=15.7.0
OPENSEARCH_VERSION=3.7.0
NGINX_IMAGE=nginx:alpine
